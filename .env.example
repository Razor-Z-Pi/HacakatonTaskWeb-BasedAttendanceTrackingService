# Docker Compose
# web-контейнер слушает 127.0.0.1:8080, наружу его отдаёт host-nginx.
WEB_PORT=8080
SEED_DATA=1
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Для локального сервера можно оставить *, для публичного — перечислите домен/IP.
DJANGO_ALLOWED_HOSTS=*
# DJANGO_CSRF_TRUSTED_ORIGINS=https://attendance.example.com

# If the frontend is served from another origin, list it here.
# For the bundled nginx + /api proxy this is normally not needed.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

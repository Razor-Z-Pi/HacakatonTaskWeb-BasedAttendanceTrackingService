# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_NAME=db.sqlite3

# Каталог с 526group.json и 526sched.json. По умолчанию ../data от backend.
# ATTENDANCE_DATA_DIR=/var/www/attendance/data

# CORS: origins of the frontend when it is served from a different host/port.
# With the nginx setup below frontend and /api share an origin, so this list is
# only needed for a separately hosted frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# If nginx terminates HTTPS, specify the public origins used by the browser.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://attendance.example.com
# DJANGO_USE_X_FORWARDED_HOST=true
